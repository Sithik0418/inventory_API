PORT=3000

# Gmail SMTP: use a Google App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAIL_TO=

# Generate a long random token and use the same value for API and scheduler.
DAILY_REPORT_TOKEN=
DAILY_REPORT_API_URL=http://localhost:3000/api/daily-bill-report
REPORT_TIMEZONE=Asia/Kolkata
